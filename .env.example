# --- Application -----------------------------------------------------------------
TROPHYCASE_ENV=development
TROPHYCASE_DEBUG=true
TROPHYCASE_SECRET_KEY=change-me-to-a-long-random-string
TROPHYCASE_ACCESS_TOKEN_TTL_SECONDS=900
TROPHYCASE_REFRESH_TOKEN_TTL_SECONDS=2592000
TROPHYCASE_ALGORITHM=HS256

# --- Databases -------------------------------------------------------------------
# Async SQLAlchemy URL (used by API, worker and Alembic alike).
# Use 127.0.0.1 instead of "localhost" - see the TLS/loopback note in README.md.
TROPHYCASE_DATABASE_URL=postgresql+asyncpg://trophycase:trophycase@127.0.0.1:5432/trophycase

# --- Redis -----------------------------------------------------------------------
TROPHYCASE_REDIS_URL=redis://127.0.0.1:6379/0
TROPHYCASE_REDIS_STREAM_KEY=trophycase:events
TROPHYCASE_REDIS_CONSUMER_GROUP=trophycase-evaluators

# --- Realtime --------------------------------------------------------------------
TROPHYCASE_WS_HEARTBEAT_SECONDS=30

# --- Rate limiting ---------------------------------------------------------------
TROPHYCASE_RATE_LIMIT_PER_MINUTE=120
TROPHYCASE_RATE_LIMIT_LOGIN_PER_MINUTE=10

# --- TLS / certificate verification ----------------------------------------------
# Point this at a PEM bundle if your network intercepts TLS (corporate proxy / custom CA).
# Leave empty to use certifi's bundled CA store. NEVER set this to disable verification.
TROPHYCASE_CA_BUNDLE=
#TROPHYCASE_CA_BUNDLE=/etc/ssl/certs/company-ca.pem

# --- Google OAuth2 (optional) ----------------------------------------------------
TROPHYCASE_OAUTH_GOOGLE_CLIENT_ID=
TROPHYCASE_OAUTH_GOOGLE_CLIENT_SECRET=
TROPHYCASE_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/oauth/google/callback

# --- Client (Flet) ---------------------------------------------------------------
TROPHYCASE_API_BASE_URL=http://127.0.0.1:8000
TROPHYCASE_WS_URL=ws://127.0.0.1:8000/v1/ws
TROPHYCASE_CLIENT_DATA_DIR=
